# Names only. Real values live in Vercel → Settings → Environment Variables.
# For local development, copy this file to .env.local and fill it in.

# --- Supabase (database + image storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Transaction pooler (port 6543), used by the app
DATABASE_URL=
# Session pooler (port 5432), used by `npm run db:migrate`
DIRECT_URL=

# --- Admin: temporary password lock until real login exists ---
ADMIN_PASSWORD=

# --- PostHog (session recordings, heatmaps) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Newsletter (Resend) ---
RESEND_API_KEY=
# e.g. Transformatrix <hello@transformatrix.life>
NEWSLETTER_FROM_EMAIL=

# Optional: public URL used in email links. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=
